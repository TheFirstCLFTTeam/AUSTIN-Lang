@startuml


entity COMMERCIAL_USER {
  *id : int
  --
  username : string
  password_hash : string
  email : string
  company_details : string
}

entity RECORDING {
  *id : int
  --
  *user_id : int <<FK>>
  file_url : string
  upload_timestamp : datetime
  status : string
}

entity RECORDING_RETENTION {
  *id : int
  --
  *recording_id : int <<FK>>
  delete_at : datetime
}

entity TRANSCRIPTION {
  *id : int
  --
  *recording_id : int <<FK>>
  content : text
  languages : string
  accuracy_score : decimal
  created_at : datetime
  updated_at : datetime
  is_reviewed : boolean
}

entity BACKEND_ENGINEER {
  *id : int
  --
  username : string
  access_level : string
}

entity PERMISSION_TYPE {
  *id : int
  --
  name : string
  description : string
}

entity ENGINEER_PERMISSION {
  *engineer_id : int <<FK>>
  *permission_id : int <<FK>>
}

entity MODEL_WEIGHTS {
  *id : int
  --
  version : string
  s3_path : string
  security_class : int
  created_at : datetime
}

COMMERCIAL_USER ||..o{ RECORDING : uploads
RECORDING ||..|{ TRANSCRIPTION : has
RECORDING ||..|| RECORDING_RETENTION : requires_deletion
BACKEND_ENGINEER ||..o{ RECORDING : monitors
BACKEND_ENGINEER ||..o{ ENGINEER_PERMISSION : has
PERMISSION_TYPE ||..o{ ENGINEER_PERMISSION : defined_as

@enduml
