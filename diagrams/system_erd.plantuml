@startuml
allow_mixing
!include ./UMLDarktheme/theme.puml

' legend:
' # -> section
' = -> entity
' - relationships

' ########################################
' #         END OF USER HANDLING         #
' ########################################

' ========================================
' SUPERTYPE: USER
' ========================================
entity "User (SUPER)" as USER {
  *user_id : int
  --
  username : string
  password_hash : string
  email : string
  department :string
  user_type : string
  ' "business" or "engineer", required for redundancy
  account_status : string
  ' active, inactive, suspended, deleted
  profile_picture : MEDIUMBLOB
}


' ========================================
' SUBTYPE: BACKEND_ENGINEER
' ========================================
entity "Backend Engineer" as BACKEND_ENGINEER {
  *user_id : int <<FK>>
  --
  data_zone_access : string
  ' "green" (no CID access) or "red" (CID access)
  phone_number : string
  engineer_id : string
  ' for tagging with any external engineer services
}


' ========================================
' SUPERTYPE: BUSINESS_USER (Verifier + Commercial User)
' ========================================
entity "Business User (SUPER)" as BUSINESS_USER {
  *user_id : int <<FK>>
  --
  business_user_type : string
  sub_department : string
  ' "commercial" or "verifier"
}
' ========================================
' LANGUAGE_PROFICIENCIES
' ========================================
entity "Language Proficiency" as LANGUAGE_PROFICIENCIES {
  *user_id : int <<FK>>
  --
  language : string
  is_main_language : boolean
}

' ========================================
' Client
' ========================================
' to indicate whether a user mainly handles a specific client
entity "Client" as CLIENT {
  *user_id : int <<FK>>
  --
  client : string
  is_main_client : boolean
  ' defined as whether the user interacts with this client a minimum of 5 times a month
  client_type : string 
  ' "company" or "individual"
  is_PEP : bool
  ' whether the client is considered a politically exposed person (PEP)
}

' ========================================
' SUBTYPE: COMMERCIAL_USER
' ========================================
' someone who just wants transcripts of recordings, nothing else
entity "Commercial User" as COMMERCIAL_USER {
  *user_id : int <<FK>>
  --
  company_details : string
  access_level_id : int <<FK>>
}

' ========================================
' SUBTYPE: VERIFIER (Risk Team)
' ========================================
' perform checks on the DB to perform risk assessments

entity "Verifier" as VERIFIER {
  *user_id : int <<FK>>
  --
  department : string
  verification_scope : string
  ' e.g., "payments", "orders"
}

' ----------------------------------------
' -         USER RELATIONSHIPS           -
' ----------------------------------------

' Disjoint inheritance from USER
usecase (d) as disjoint
USER -- disjoint : "is a (total participation)"
disjoint <|-- BUSINESS_USER
disjoint <|-- BACKEND_ENGINEER

' Disjoint inheritance from BUSINESS_USER
usecase (d) as disjoint_business
BUSINESS_USER -- disjoint_business : "is a (total participation)"
disjoint_business <|-- COMMERCIAL_USER
disjoint_business <|-- VERIFIER

BUSINESS_USER ||--o{ CLIENT
BUSINESS_USER ||--o{ LANGUAGE_PROFICIENCIES

' ########################################
' #         END OF USER HANDLING         #
' ########################################



' ########################################
' #     START OF USER PERM HANDLING      #
' ########################################

' ========================================
' USER_PERMISSION_GROUP (For all user types)
' ========================================
entity "User Permission Group" as USER_PERMISSION_GROUP {
  *id : int
  --
  name : string
  ' "Admin", "Enginner", "Verifier", "Commercial User"  
  description : string
}


' ========================================
' GROUP_PERMISSION
' ========================================
entity "Group Permission" as GROUP_PERMISSION {
  *group_id : int <<FK>>
  *permission_id : int <<FK>>
  --
  ' Consolidated attributes from Commercial Access Level
  max_uploads_per_day : int
  max_storage_mb : int
}

USER_PERMISSION_GROUP ||--o{ GROUP_PERMISSION


' ========================================
' USER_GROUP_MEMBERSHIP
' ========================================
entity "User Group Membership" as USER_GROUP_MEMBERSHIP {
  *user_id : int <<FK>>
  *group_id : int <<FK>>
}

USER ||--o{ USER_GROUP_MEMBERSHIP
USER_PERMISSION_GROUP ||--o{ USER_GROUP_MEMBERSHIP


' ========================================
' PERMISSION_TYPE
' ========================================
entity PERMISSION_TYPE {
  *id : int
  --
  name : string
  description : string
}

' ========================================
' ENGINEER_PERMISSION
' ========================================
entity ENGINEER_PERMISSION {
  *engineer_id : int <<FK>>
  *permission_id : int <<FK>>
}



' ========================================
' USER_PERMISSION (For all user types)
' ========================================
entity USER_PERMISSION {
  *user_id : int <<FK>>
  *permission_id : int <<FK>>
}
entity COMMERCIAL_USER_ACCESS_LEVEL {
  *id : int
  --
  name : string
  ' e.g., "basic", "standard", "premium"
  description : string
  max_uploads_per_day : int
  max_storage_mb : int
}

' ########################################
' #      END OF USER PERM HANDLING       #
' ########################################


' ========================================
' RECORDING
' ========================================
entity RECORDING {
  *rec_id : int
  --
  *user_id : int <<FK>>
  file_url : string
  upload_timestamp : datetime
  status : string
  ' pending, processing, completed, failed
  is_cid_stripped : boolean
  ' Indicates if personally identifiable data (CID) has been masked
}

' ========================================
' RECORDING_METADATA
' ========================================
entity RECORDING_METADATA {
  *rec_met_id : int
  --
  *recording_id : int <<FK>>
  metadata : json
  call_origin : string
  ' "internal" or "external"
  phone_number : string
}

' ========================================
' CALL_TYPE_CATEGORY (Lookup table for category types)
' ========================================
entity CALL_TYPE_CATEGORY {
  *id : int
  --
  name : string
  ' e.g., "purpose", "transaction_type", "risk_level"
  description : string
}

' ========================================
' CALL_TYPE_VALUE (Available values for each category)
' ========================================
entity CALL_TYPE_VALUE {
  *id : int
  --
  *category_id : int <<FK>>
  value : string
  ' e.g., "business_call", "bank_transfer", "large_investment"
  description : string
}

' ========================================
' RECORDING_CALL_TYPE (Associative entity: recordings to call types)
' ========================================
entity RECORDING_CALL_TYPE {
  *recording_id : int <<FK>>
  *call_type_value_id : int <<FK>>
}

CALL_TYPE_CATEGORY ||--o{ CALL_TYPE_VALUE : has_values
RECORDING ||--o{ RECORDING_CALL_TYPE : categorized_as
CALL_TYPE_VALUE ||--o{ RECORDING_CALL_TYPE : applies_to

' ========================================
' RECORDING_RETENTION
' ========================================
entity RECORDING_RETENTION {
  *id : int
  --
  *recording_id : int <<FK>>
  delete_at : datetime
  ' Enforced: delete_at = upload_timestamp + 7 calendar days
}

' ========================================
' DELETION_LOG (Audit trail for deletions)
' ========================================
entity DELETION_LOG {
  *id : int
  --
  *recording_id : int <<FK>>
  deleted_at : datetime
  deleted_by : int <<FK>>
  ' FK to USER
}

' ========================================
' TRANSCRIPTION
' ========================================
entity TRANSCRIPTION {
  *id : int
  --
  *recording_id : int <<FK>>
  content : text
  languages : string
  accuracy_score : decimal
  created_at : datetime
  updated_at : datetime
  is_reviewed : boolean
  corrected_content : text
  ' Stores user-submitted corrections for retraining
  missing_terms : text
  ' Flags terms that compliance requires but are absent
}


' ========================================
' MODEL_WEIGHTS
' ========================================
entity MODEL_WEIGHTS {
  *id : int
  --
  *created_by_engineer_id : int <<FK>>
  version : string
  s3_path : string
  security_class : int
  created_at : datetime
  data_zone : string
  ' "green" (no CID access) or "red" (CID access)
}

' ========================================
' MODEL_TRAINING_DATA
' ========================================
entity MODEL_TRAINING_DATA {
  *model_id : int <<FK>>
  *recording_id : int <<FK>>
}

' ========================================
' FINANCIAL_TERM_DICTIONARY
' ========================================
entity FINANCIAL_TERM_DICTIONARY {
  *id : int
  --
  term : string
  category : string
  ' Domain-specific category
  language : string
}

' ========================================
' DAILY_CALL_STATISTICS (Rollup/Aggregate table)
' ========================================
entity DAILY_CALL_STATISTICS {
  *id : int
  --
  date : date
  total_calls : int
  avg_duration_seconds : decimal
  min_duration_seconds : int
  max_duration_seconds : int
  std_deviation_seconds : decimal
  total_corrections : int
  total_flagged_violations : int
  ' Tracks calls with positive risk identified
}

' ========================================
' REAL_DATA_PAIR (Tracks real recording + transcription pairs)
' ========================================
entity REAL_DATA_PAIR {
  *id : int
  --
  *recording_id : int <<FK>>
  *transcription_id : int <<FK>>
  created_at : datetime
}

' ========================================
' SYNTHETIC_DATA_PAIR (Tracks synthetic pairs from real pairs)
' ========================================
entity SYNTHETIC_DATA_PAIR {
  *id : int
  --
  *real_data_pair_id : int <<FK>>
  synthetic_recording_url : string
  synthetic_transcription : text
  created_at : datetime
  generation_module_version : string
}

REAL_DATA_PAIR ||--o{ SYNTHETIC_DATA_PAIR : generates

' ========================================
' RELATIONSHIPS
' ========================================
COMMERCIAL_USER ||..o{ RECORDING : uploads
COMMERCIAL_USER ||..o{ RECORDING : accesses
COMMERCIAL_USER ||..o{ TRANSCRIPTION : accesses
VERIFIER ||..o{ RECORDING : accesses
VERIFIER ||..o{ TRANSCRIPTION : accesses
RECORDING ||..|| RECORDING_METADATA : has_metadata
RECORDING ||..|{ TRANSCRIPTION : has
RECORDING ||..|| RECORDING_RETENTION : requires_deletion
RECORDING ||--o{ DELETION_LOG : logs_deletion
USER ||--o{ DELETION_LOG : performed_by
BACKEND_ENGINEER ||..o{ RECORDING : monitors
BACKEND_ENGINEER ||..o{ ENGINEER_PERMISSION : has
PERMISSION_TYPE ||..o{ ENGINEER_PERMISSION : defined_as
USER ||..o{ USER_PERMISSION : has
PERMISSION_TYPE ||..o{ USER_PERMISSION : defined_as
BACKEND_ENGINEER ||..o{ MODEL_WEIGHTS : creates
MODEL_WEIGHTS ||..|{ MODEL_TRAINING_DATA : trained_on
RECORDING ||..|{ MODEL_TRAINING_DATA : used_in
RECORDING ||--o{ REAL_DATA_PAIR : part_of
TRANSCRIPTION ||--o{ REAL_DATA_PAIR : part_of

@enduml
  