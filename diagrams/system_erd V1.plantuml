@startuml

!include ./UMLDarktheme/theme.puml

' ========================================
' SUPERTYPE: USER
' ========================================
entity "USER (SUPER)" as USER {
  *id : int
  --
  username : string
  password_hash : string
  email : string
  user_type : string
  ' "commercial" or "engineer"
}

' ========================================
' SUBTYPE: COMMERCIAL_USER
' ========================================
entity COMMERCIAL_USER {
  *user_id : int <<FK>>
  --
  company_details : string
}

' ========================================
' SUBTYPE: BACKEND_ENGINEER
' ========================================
entity BACKEND_ENGINEER {
  *user_id : int <<FK>>
  --
  access_level : string
}

USER ||--|| COMMERCIAL_USER : is_a
USER ||--|| BACKEND_ENGINEER : is_a

entity RECORDING {
  *rec_id : int
  --
  *user_id : int <<FK>>
  file_url : string
  upload_timestamp : datetime
  status : string
  ' pending, processing, completed, failed
}

entity RECORDING_METADATA {
  *rec_met_id : int
  --
  *recording_id : int <<FK>>
  metadata : json
}

entity RECORDING_RETENTION {
  *id : int
  --
  *recording_id : int <<FK>>
  delete_at : datetime
}

entity TRANSCRIPTION {
  *id : int
  --
  *recording_id : int <<FK>>
  content : text
  languages : string
  accuracy_score : decimal
  created_at : datetime
  updated_at : datetime
  is_reviewed : boolean
}

entity PERMISSION_TYPE {
  *id : int
  --
  name : string
  description : string
}

entity ENGINEER_PERMISSION {
  *engineer_id : int <<FK>>
  *permission_id : int <<FK>>
}


entity MODEL_WEIGHTS {
  *id : int
  --
  *created_by_engineer_id : int <<FK>>
  version : string
  s3_path : string
  security_class : int
  created_at : datetime
}

entity MODEL_TRAINING_DATA {
  *model_id : int <<FK>>
  *recording_id : int <<FK>>
}


COMMERCIAL_USER ||..o{ RECORDING : uploads
RECORDING ||..|{ TRANSCRIPTION : has
RECORDING ||..|| RECORDING_RETENTION : requires_deletion
BACKEND_ENGINEER ||..o{ RECORDING : monitors
BACKEND_ENGINEER ||..o{ ENGINEER_PERMISSION : has
PERMISSION_TYPE ||..o{ ENGINEER_PERMISSION : defined_as
BACKEND_ENGINEER ||..o{ MODEL_WEIGHTS : creates
MODEL_WEIGHTS ||..|{ MODEL_TRAINING_DATA : trained_on
RECORDING ||..|{ MODEL_TRAINING_DATA : used_in

@enduml
