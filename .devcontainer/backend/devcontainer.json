{
    "name": "AUSTIN Backend",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",

    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest",
            "moby": true
        }
    },

    // Install the Docker Compose plugin and common dev requirements for each service.
    "postCreateCommand": "pip install --upgrade pip && pip install pytest pytest-asyncio httpx",

    // Forward ports for all backend services (see compose.yaml).
    // Actual port numbers depend on your .env; these match the service defaults.
    "forwardPorts": [8000, 8001, 8002, 8003, 8005],
    "portsAttributes": {
        "8000": {
            "label": "Audio Submission",
            "onAutoForward": "silent"
        },
        "8001": {
            "label": "Transcription Orchestrator",
            "onAutoForward": "silent"
        },
        "8002": {
            "label": "Database Service",
            "onAutoForward": "silent"
        },
        "8003": {
            "label": "Transcription Server",
            "onAutoForward": "silent"
        },
        "8005": {
            "label": "Transcription Service 2",
            "onAutoForward": "silent"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.pylint",
                "ms-python.debugpy",
                "ms-azuretools.vscode-docker",
                "ms-python.black-formatter",
                "njpwerner.autodocstring",
                "eamodio.gitlens"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "editor.formatOnSave": true,
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter"
                },
                "python.testing.pytestEnabled": true,
                "python.testing.pytestArgs": ["--tb=short"]
            }
        }
    },

    "remoteUser": "vscode"
}
