{
    "name": "AUSTIN-Lang Dev",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "workspaceFolder": "/workspaces/AUSTIN-Lang",
    "forwardPorts": [3000, 8010],
    "postCreateCommand": "cd frontend && npm install",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "dbaeumer.vscode-eslint",
                "jaredly.background-terminal-notifier"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
        "version": "latest",
        "enableNonRootDocker": "true",
        "moby": "true"
        }
    }
}
