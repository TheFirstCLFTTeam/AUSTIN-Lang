[
  {
    "audio": "audio/0000_audio.mp3",
    "text": "我冇讀過政治學，有錯麻煩各位指正。"
  },
  {
    "audio": "audio/0001_audio.mp3",
    "text": "上下聯對仗工整，但內容無關嘅對聯（量詞：副／對）"
  },
  {
    "audio": "audio/0002_audio.mp3",
    "text": "追求一個人而令到嗰個人對自己有好感"
  },
  {
    "audio": "audio/0003_audio.mp3",
    "text": "鍾意某人，對某人帶有愛意"
  },
  {
    "audio": "audio/0004_audio.mp3",
    "text": "個蘋果好大個，不如我哋一人一半食咗佢？"
  },
  {
    "audio": "audio/0005_audio.mp3",
    "text": "一直以來有嘅、存在嘅"
  },
  {
    "audio": "audio/0006_audio.mp3",
    "text": "喺一群人入面落決定"
  },
  {
    "audio": "audio/0007_audio.mp3",
    "text": "對人哋個仔嘅敬稱（量詞:名/位/個）"
  },
  {
    "audio": "audio/0008_audio.mp3",
    "text": "呢次地震係黎克特震級六點八級。"
  },
  {
    "audio": "audio/0009_audio.mp3",
    "text": "叻、精於某樣嘢"
  }
]